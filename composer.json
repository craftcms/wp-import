{
  "name": "craftcms/wp-import",
  "description": "WordPress → Craft CMS content importer",
  "type": "library",
  "keywords": [
    "cms",
    "craftcms",
    "laravel",
    "wordpress"
  ],
  "homepage": "https://craftcms.com",
  "license": "mit",
  "authors": [
    {
      "name": "Pixel & Tonic",
      "homepage": "https://pixelandtonic.com/"
    }
  ],
  "support": {
    "email": "support@craftcms.com",
    "issues": "https://github.com/craftcms/wp-import/issues?state=open",
    "source": "https://github.com/craftcms/wp-import",
    "rss": "https://github.com/craftcms/wp-import/releases.atom"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.5",
    "craftcms/cms": "^6.0.0",
    "craftcms/url-validator": "^1.2",
    "symfony/css-selector": "^7.0|^8.0",
    "symfony/dom-crawler": "^7.0|^8.0"
  },
  "require-dev": {
    "craftcms/ckeditor": "dev-feature/craft-6",
    "larastan/larastan": "^3.13",
    "laravel/pint": "^1.22",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "CraftCms\\WpImport\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CraftCms\\WpImport\\Tests\\": "tests/",
      "CraftCms\\Cms\\Database\\Factories\\": "vendor/craftcms/cms/database/Factories/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "CraftCms\\WpImport\\WpImportServiceProvider"
      ]
    }
  },
  "scripts": {
    "check-cs": "pint --test",
    "fix-cs": "pint",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "pest"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.5"
    },
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true
    }
  }
}
